# Base
APP_NAME=BuildingAI
# if you deploy to production, please set this to real url
# example: https://www.buildingai.cc
APP_DOMAIN=

# Server
SERVER_PORT=4090
SERVER_CORS_ENABLED=true
SERVER_CORS_ORIGIN=*
SERVER_SHOW_DETAILED_ERRORS=false
SERVER_IS_DEMO_ENV=false

# PM2
PM2_APP_NAME=buildingai
PM2_INSTANCES=1
PM2_EXEC_MODE=cluster
PM2_MAX_MEMORY=1G
PM2_WATCH=false
PM2_LOG_DIR=../../logs/pm2
PM2_AUTORESTART=true
PM2_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss Z

# JWT
JWT_SECRET=buildingai
JWT_EXPIRES_IN=30d

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=buildingai
DB_SYNCHRONIZE=false
DB_DEV_SYNCHRONIZE=true
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=60*60*24
REDIS_MAX_RECONNECT_ATTEMPTS=5
REDIS_RECONNECT_DELAY=3000

# Cache
CACHE_TTL=86400
CACHE_MAX_ITEMS=1000

# Logs
# "log" | "error" | "warn" | "debug" | "verbose" | "fatal"
LOG_LEVELS=error,warn,debug,fatal
LOG_WRITE_LEVELS=error,warn,debug,fatal,log
LOG_TO_FILE=true
LOG_DATABASE_SCHEMA=false
LOG_CLEAN_INTERVAL=3

# Web
VITE_DEVELOP_APP_BASE_URL=http://localhost:4090
# If your backend API domain is different from APP_DOMAIN, please configure this option
VITE_PRODUCTION_APP_BASE_URL=
VITE_APP_WEB_API_PREFIX=/api
VITE_APP_CONSOLE_API_PREFIX=/consoleapi

# Docker
NPM_REGISTRY_URL=https://registry.npmmirror.com
DOCKER_CONTAINER_SUFFIX=
DOCKER_MEMORY_LIMIT=6144M
DOCKER_CPU_LIMIT=2.0
DOCKER_MEMORY_RESERVATION=512M
# This option will make the database and Redis ports in the Docker container fixed.
POSTGRES_EXTERNAL_PORT=
REDIS_EXTERNAL_PORT=

# ── a2a-gateway（独立容器，跟 nodejs 在同一 docker network）──
# 这两个值必须跟 Web 端 /install 时设的 root 账号密码一致
# a2a-gateway 启动后会用它们登录 BuildingAI 拉 agent / dataset 列表
BAI_USERNAME=
BAI_PASSWORD=
# BuildingAI 内网地址（docker network 内 DNS 把 nodejs 解析到 nodejs 容器）
BAI_BASE=http://nodejs:4090
# a2a-gateway 监听（绑 0.0.0.0 让外部端口能映射进来；只内网用可改 127.0.0.1）
GATEWAY_HOST=0.0.0.0
# a2a-gateway 端口（跟 docker-compose.yml 里的 GATEWAY_PORT 保持一致）
GATEWAY_PORT=8000

# ── a2a-gateway admin UI 鉴权（web UI 设 / 加用户 / 改配置都要这个 token）──
# 留空 → admin 写端点不鉴权（仅内网用）
# 配值 → 所有写端点要 X-Admin-Token header 一致
# 生成：openssl rand -hex 32
A2A_ADMIN_TOKEN=

# ── a2a-gateway 多用户鉴权（可选，留空则只支持单用户 BAI_USERNAME）──
# MASTER_KEY 用 Fernet 对称加密，生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时下面 A2A_GATEWAY_USERS 不会生效（所有请求都按单用户走）
A2A_GATEWAY_MASTER_KEY=
# 格式：api_key1:bai_username1:enc_password1,api_key2:bai_username2:enc_password2
# enc_password 生成（先启动 a2a-gateway 容器拿到 config）：
#   docker exec buildingai-a2a-gateway python3 -c "from config import encrypt_password; print(encrypt_password('plain_password_here'))"
# 把输出粘到这里作为 enc_password
# BuildingAI 用户要先在 Web 端"用户管理"里建好（不是 /install 创建的 root）
A2A_GATEWAY_USERS=